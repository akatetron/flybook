{
  "expo": {
    "name": "FlyBook",
    "slug": "flybook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.flybook"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1510",
